# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# MySQL connection (see storage/MySqlStorage.php, bin/migrate.php)
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=docket;charset=utf8mb4
DB_USER=
DB_PASS=

# From the Slack app's dashboard (see CLAUDE.md's Requirements section)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# "Due soon" callout window, in days
DUE_SOON_DAYS=3

# How long a task's source-message link stays shown, in days — matches
# Slack free-plan message retention
SOURCE_LINK_MAX_AGE_DAYS=90

# Set to 1 to log every incoming Slack payload's type/callback_id to
# error_log, for diagnosing webhook issues live. Leave unset in normal use.
DEBUG_LOGGING=
