# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# MySQL connection (see storage/MySqlStorage.php, bin/migrate.php)
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=docket;charset=utf8mb4
DB_USER=
DB_PASS=

# From the Slack app's dashboard (see CLAUDE.md's Requirements section)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# "Due soon" callout window, in days (see CLAUDE.md's Decisions section)
DUE_SOON_DAYS=3
